  "QuestionStmt": {
    "S": "Two cards are drawn simultaneously from a well shuffled pack of 52 cards. If X is the random variable of getting queens, then the value of $2E(X) + 3E(X^2)$ for the number of queens is"
  },
  "QuestionType": {
    "S": "MCQSC"
  },
  "QuestionImg": {
    "S": "NA"
  },
  "Option1Stmt": {
    "S": "$\\frac{132}{221}$"
  },
  "Option1Img": {
    "S": "NA"
  },
  "Option2Stmt": {
