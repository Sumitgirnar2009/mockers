  "QuestionStmt": {
    "S": "The rate constant for a first order reaction is $0.58 \\, \\text{s}^{-1}$ at 300 K and $0.026 \\, \\text{s}^{-1}$ at 290 K. What is the energy of activation? ($R = 8.314 \\, \\text{J K}^{-1} \\, \\text{mol}^{-1}$)"
  },
  "QuestionType": {
    "S": "MCQSC"
  },
